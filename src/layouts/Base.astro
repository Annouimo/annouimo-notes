---
import '../../.shared-design/tokens.css';
import '../../.shared-design/navigation.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; preview?: boolean }
const { title = '求知札记', description = '通过可探索的数学与物理讲义来学习。', preview = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    {!preview && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <meta name="theme-color" content="#f5f4ed" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === '求知札记' ? title : `${title} · 求知札记`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="ann-topbar">
      <div class="ann-site-identity">
        <a href={preview ? 'https://shared-design.www.annouimo.com/' : 'https://www.annouimo.com/'} aria-label="Annouimo 的个人主页">Annouimo</a>
        <span aria-hidden="true">›</span>
        <a href="/">求知札记</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><a href="/">求知札记</a><span>把问题想明白，把解释留下来。</span><a href="https://github.com/Annouimo/why-notes">源代码 ↗</a></footer>
  </body>
</html>
