---
interface Props {
  kind: 'field' | 'differential' | 'potential' | 'flux' | 'divergence' | 'curl' | 'cancellation' | 'forms' | 'charge' | 'coupling' | 'wave-shift' | 'gauss-sphere' | 'gauss-cone' | 'volume-cancel' | 'potential-slopes' | 'differential-plane' | 'differential-error' | 'flux-plane' | 'mixed-partials' | 'boundary-square'
}
const { kind } = Astro.props;

type Point3 = { x: number; y: number; z: number };
const vAdd = (a: Point3, b: Point3): Point3 => ({x:a.x+b.x,y:a.y+b.y,z:a.z+b.z});
const vScale = (a: Point3, s: number): Point3 => ({x:a.x*s,y:a.y*s,z:a.z*s});
const vCross = (a: Point3, b: Point3): Point3 => ({x:a.y*b.z-a.z*b.y,y:a.z*b.x-a.x*b.z,z:a.x*b.y-a.y*b.x});
const vUnit = (a: Point3): Point3 => { const len=Math.hypot(a.x,a.y,a.z); return vScale(a,1/len); };
const pathPoints = (points: {x:number;y:number}[], close=false):string =>
  points.map((p,i)=>(i?'L':'M')+p.x.toFixed(1)+' '+p.y.toFixed(1)).join(' ')+(close?' Z':'');
const diffP = (x:number,y:number,z:number) => ({x:230+155*x-115*y,y:70+94*x+101*y-17*z});
const dA=diffP(0,0,0),dC=diffP(1,0,4),dD=diffP(0,1,2),dB=diffP(1,1,6);
const dC0=diffP(1,0,0),dD0=diffP(0,1,0),dB0=diffP(1,1,0);
const fluxP = (p:Point3) => ({x:185+1.1*p.x-.65*p.y,y:150+.47*p.x+.75*p.y-p.z});
const fluxU:Point3={x:135,y:0,z:20}, fluxV:Point3={x:0,y:100,z:35};
const fluxCenter=vScale(vAdd(fluxU,fluxV),.5);
const fluxNormal=vUnit(vCross(fluxU,fluxV));
const fluxB:Point3={x:.5,y:-.3,z:.85};
const fpCorners=[{x:0,y:0,z:0},fluxU,vAdd(fluxU,fluxV),fluxV].map(fluxP);
const fpCenter=fluxP(fluxCenter),fpNormalTip=fluxP(vAdd(fluxCenter,vScale(fluxNormal,95)));
const fpBT=fluxP(vAdd(fluxCenter,vScale(fluxB,105)));
const fpBG=[{x:55,y:20,z:-15},{x:122,y:100,z:45},{x:165,y:5,z:5}].map(q=>({start:fluxP(q),end:fluxP(vAdd(q,vScale(fluxB,115)))}));
const curve3=(u:number,v:number):Point3=>({x:100*u,y:80*v,z:23*Math.sin(1.2*u)+13*v*v+18*u*v});
const curveTanU=(u:number,v:number):Point3=>({x:100,y:0,z:27.6*Math.cos(1.2*u)+18*v});
const curveTanV=(u:number,v:number):Point3=>({x:0,y:80,z:26*v+18*u});
const cU=.25,cV=-.09,cCenter=curve3(cU,cV);
const cNormal=vUnit(vCross(curveTanU(cU,cV),curveTanV(cU,cV)));
const curveP=(p:Point3)=>({x:221+1.12*p.x-.69*p.y,y:175+.42*p.x+.74*p.y-1.05*p.z});
const zoomP=(p:Point3)=>({x:566+2.1*(p.x-cCenter.x)-1.5*(p.y-cCenter.y),y:168+.83*(p.x-cCenter.x)+1.55*(p.y-cCenter.y)-2.05*(p.z-cCenter.z)});
const crange=[-1.15,-.75,-.35,.05,.45,.85,1.15],vrange=[-.86,-.43,0,.43,.86];
const curveBorders=[
  Array.from({length:26},(_,i)=>curveP(curve3(-1.15+i*2.3/25,-.86))),
  Array.from({length:26},(_,i)=>curveP(curve3(1.15,-.86+i*1.72/25))),
  Array.from({length:26},(_,i)=>curveP(curve3(1.15-i*2.3/25,.86))),
  Array.from({length:26},(_,i)=>curveP(curve3(-1.15,.86-i*1.72/25)))
];
const curveOutline=pathPoints(curveBorders.flat(),true);
const curveGridU=crange.map(u=>pathPoints(Array.from({length:19},(_,i)=>curveP(curve3(u,-.86+i*1.72/18)))));
const curveGridV=vrange.map(v=>pathPoints(Array.from({length:23},(_,i)=>curveP(curve3(-1.15+i*2.3/22,v)))));
const patchCorners=[curve3(.08,-.3),curve3(.43,-.3),curve3(.43,.13),curve3(.08,.13)];
const patchPath=pathPoints(patchCorners.map(curveP),true);
const zoomCorners=[
  vAdd(cCenter,vAdd(vScale(curveTanU(cU,cV),-.21),vScale(curveTanV(cU,cV),-.27))),
  vAdd(cCenter,vAdd(vScale(curveTanU(cU,cV),.21),vScale(curveTanV(cU,cV),-.27))),
  vAdd(cCenter,vAdd(vScale(curveTanU(cU,cV),.21),vScale(curveTanV(cU,cV),.27))),
  vAdd(cCenter,vAdd(vScale(curveTanU(cU,cV),-.21),vScale(curveTanV(cU,cV),.27)))
].map(zoomP);
const curveCenter=curveP(cCenter),curveNtip=curveP(vAdd(cCenter,vScale(cNormal,75)));
const zoomCenter=zoomP(cCenter),zoomNtip=zoomP(vAdd(cCenter,vScale(cNormal,48)));
const curveFieldTips=[{u:-.86,v:-.47},{u:-.35,v:.38},{u:.68,v:-.53},{u:.87,v:.4}].map(q=>{
  const start=curve3(q.u,q.v);return {p:curveP(start),tip:curveP(vAdd(start,vScale(fluxB,77)))};
});

---
<figure class="box-explorer teaching-figure" data-kind={kind}>
  {kind === 'field' && <>
    <div class="figure-top"><h3>从一条曲线，到一个空间中的场</h3><span>图 1 · 描述方式</span></div>
    <svg viewBox="0 0 640 337" role="img" aria-label="左侧是一维E(x)曲线，右侧是有三维坐标轴的空间盒子，多个网格位置分布着方向与长度不同的场向量，图形与文字位于互不重叠的区域">
<defs><marker id="f3d-f" markerWidth="6.5" markerHeight="6.5" refX="5.3" refY="3.2" orient="auto"><path d="M0 0L6.4 3.2L0 6.4Z" fill="var(--curve)"/></marker></defs>
<text x="138" y="24" text-anchor="middle" class="figure-title">只沿一条线取样</text>
<text x="478" y="24" text-anchor="middle" class="figure-title">整个三维空间上的矢量场</text>
<path d="M48 270V61M48 270H271" stroke="var(--muted)" stroke-width="1.5" fill="none"/>
<path d="M50 241Q95 240 134 190T265 79" stroke="var(--curve)" stroke-width="3.5" fill="none"/>
<circle cx="158" cy="160" r="4.8" fill="var(--red)"/><path d="M158 160V270" stroke="var(--muted)" stroke-dasharray="4 4"/>
<text x="29" y="67" class="legend">E</text><text x="263" y="289" class="legend">x</text>
<text x="150" y="300" text-anchor="middle" class="tick">给定 x，读出一个数值</text>
<path d="M438 246L560 282L354 282Z" fill="var(--soft)" fill-opacity=".45" stroke="var(--border)" stroke-width="1.4"/>
<path d="M438 246V80L560 116V282M438 80L354 116V282M354 116L476 152L560 116M476 152V318" stroke="var(--border)" fill="none" stroke-width="1.4"/>
<path d="M438 246L580 287M438 246L338 280M438 246V58" stroke="var(--muted)" stroke-width="1.7"/>
<text x="588" y="289" class="figure-point">x</text><text x="329" y="290" class="figure-point">y</text><text x="432" y="49" class="figure-point">z</text>
{[0,1,2].flatMap(i=>[0,1,2].flatMap(j=>[0,1,2].map(k=>{
  const x=438+(i-1)*46-(j-1)*28,y=246+(i-1)*14+(j-1)*13-k*53;
  const dx=8+i*5,dy=-12-j*2-k*2;
  return <g><circle cx={x} cy={y} r="1.8" fill="var(--muted)"/><line x1={x} y1={y} x2={x+dx} y2={y+dy} stroke="var(--curve)" stroke-width="2.0" marker-end="url(#f3d-f)"/></g>;
})))}
<text x="478" y="332" text-anchor="middle" class="tick">箭头画在空间中，而非某张平面上</text>
</svg>
    <figcaption>左侧沿一条直线取样得到单变量曲线；右侧展示三维空间中多处位置的场向量。箭头方向与长度分别表示场的方向和大小；图上箭头只是连续场的少量取样。</figcaption>
  </>}
  {kind === 'differential' && <>
    <div class="figure-top"><h3>两份变化，为什么可以相加？</h3><span>图 2 · 切平面</span></div>
    <svg viewBox="0 0 690 384" role="img" aria-label="左边是二元函数z=x平方加2y在点A的局部真实蓝色弯曲曲面、绿色切平面平行四边形和下方灰色水平参考平面。两条路径从A到B，增量分别是4Δx与2Δy，真实B撇比切平面B略高。右侧逐步文字解释。">
<text x="16" y="24" class="figure-title">在 A=(2,1,6) 处放大函数的局部</text>
<path d="M191 240L333 254L265 285L123 271Z" fill="var(--soft)" stroke="var(--border)" stroke-width="1.5"/>
<text x="207" y="318" text-anchor="middle" class="tick">z=6 的水平参考平面</text>
<path d="M191 240L333 254M191 240L123 271" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="4 4" fill="none"/>
<text x="341" y="265" class="tick">Δx</text><text x="91" y="279" class="tick">Δy</text>
<path d="M191 240Q256 203 333 166L265 148Q197 193 123 224Z" fill="var(--curve)" fill-opacity=".13" stroke="var(--curve)" stroke-width="2"/>
<path d="M191 240Q256 203 333 166M155 231Q215 191 299 156M123 224Q190 180 265 148" stroke="var(--curve)" stroke-width="1.5" fill="none" opacity=".75"/>
<path d="M191 240L333 192L265 176L123 224Z" fill="var(--green)" fill-opacity=".19" stroke="var(--green)" stroke-width="2.7"/>
<path d="M191 240L333 192M333 192L265 176M265 176L123 224M123 224L191 240" stroke="var(--green)" stroke-width="2.3" fill="none"/>
<path d="M333 254V192M123 271V224M265 285V176" stroke="var(--muted)" stroke-dasharray="4 4" stroke-width="1.4"/>
<path d="M265 176V148" stroke="var(--red)" stroke-dasharray="4 3" stroke-width="2.6"/>
<path d="M191 240L333 192" stroke="var(--curve)" stroke-width="3.7"/>
<path d="M191 240L123 224" stroke="var(--green)" stroke-width="3.7"/>
{[{x:191,y:240,t:'A',tx:202,ty:259},{x:333,y:192,t:'C',tx:342,ty:205},{x:123,y:224,t:'D',tx:112,ty:214},{x:265,y:176,t:'B',tx:276,ty:186},{x:265,y:148,t:'B′',tx:239,ty:137}].map(p=><g><circle cx={p.x} cy={p.y} r="4.8" fill={p.t.includes('′')?'var(--red)':'var(--fg)'}/><text x={p.tx} y={p.ty} class="figure-point">{p.t}</text></g>)}
<path d="M354 67H377" stroke="var(--curve)" stroke-width="2.6"/><text x="387" y="71" class="legend">真实弯曲曲面（蓝）</text>
<path d="M354 99H377" stroke="var(--green)" stroke-width="3.2"/><text x="387" y="103" class="legend">局部切平面（绿）</text>
<path d="M354 131H377" stroke="var(--red)" stroke-width="2.6" stroke-dasharray="4 4"/><text x="387" y="135" class="legend">曲面与切平面的误差</text>
<text x="359" y="181" class="figure-point">沿切平面的两条走法：</text>
<text x="359" y="209" class="legend">A→C：沿 x，增加 4Δx</text>
<text x="359" y="235" class="legend">C→B：沿 y，增加 2Δy</text>
<text x="359" y="268" class="legend">或 A→D→B，仍是这两项</text>
<text x="359" y="306" class="figure-point">切平面：4Δx + 2Δy</text>
<text x="359" y="330" class="legend">真实曲面：再多 (Δx)²</text>
<text x="15" y="374" class="tick">图将位移和高度放大表示；具体增量由正文中的 f(x,y)=x²+2y 计算得到。</text>
</svg>
    <figcaption>浅蓝网格是原函数曲面，绿色是切平面，底部是 z=6 的辅助平面。注意 B′（真实函数值）与 B（切平面近似）并不重合；它们的高度差是 Δx²。放大观察这个差异，才能看清为什么全微分是局部近似。</figcaption>
  </>}
  {kind === 'potential' && <>
    <div class="figure-top"><h3>沿等势线走，为什么电势不变？</h3><span>图 3 · 电势与梯度</span></div>
    <svg viewBox="0 0 600 302" role="img" aria-label="等势线沿竖直方向，中央点发出向右的静电场箭头、向左的梯度箭头、向上的等势移动箭头和斜向左上的一般位移；虚线显示斜向位移的水平投影。">
<defs><marker id="f-pot-e" markerWidth="8" markerHeight="8" refX="6" refY="3.5" orient="auto"><path d="M0 0L8 3.5L0 7Z" fill="var(--curve)"/></marker><marker id="f-pot-g" markerWidth="8" markerHeight="8" refX="6" refY="3.5" orient="auto"><path d="M0 0L8 3.5L0 7Z" fill="var(--red)"/></marker><marker id="f-pot-u" markerWidth="8" markerHeight="8" refX="6" refY="3.5" orient="auto"><path d="M0 0L8 3.5L0 7Z" fill="var(--green)"/></marker></defs>
<text x="12" y="20" class="figure-title">电势相同的竖线；向左电势增高，向右电势降低</text>
{[96,171,246,321,396,471].map((x,i)=><g><line x1={x} y1="52" x2={x} y2="244" stroke="var(--border)" stroke-width="2" stroke-dasharray="5 5"/><text x={x} y="263" text-anchor="middle" class="tick">{5-i} V</text></g>)}
<circle cx="246" cy="168" r="5" fill="var(--fg)"/>
<path d="M246 168V79" stroke="var(--green)" stroke-width="3" marker-end="url(#f-pot-u)"/><text x="259" y="88" class="legend">沿等势线：无变化</text>
<path d="M246 168H350" stroke="var(--curve)" stroke-width="3.1" marker-end="url(#f-pot-e)"/><text x="358" y="186" class="legend">E</text>
<path d="M246 168H155" stroke="var(--red)" stroke-width="3" marker-end="url(#f-pot-g)"/><text x="154" y="187" class="legend">∇φ</text>
<path d="M246 168L173 98" stroke="var(--green)" stroke-width="3" marker-end="url(#f-pot-u)"/>
<path d="M173 98V168" stroke="var(--muted)" stroke-dasharray="4 4" stroke-width="1.7"/>
<path d="M173 168H246" stroke="var(--muted)" stroke-dasharray="4 4" stroke-width="1.7"/>
<text x="109" y="83" class="legend">斜位移 u</text>
<text x="65" y="119" class="tick">水平投影</text><text x="65" y="135" class="tick">= |u| cosθ</text><text x="210" y="148" class="tick">θ</text>
<text x="13" y="291" class="tick">沿等势线：0 / 垂直等势线：变化最快 / 斜向：只计算沿梯度的投影</text>
</svg>
    <figcaption>沿等势线移动电势不变；沿垂直方向变化最快；斜向移动只取位移在梯度方向的投影。静电场与电势梯度相反。</figcaption>
  </>}
  {kind === 'flux' && <>
    <div class="figure-top"><h3>曲面上的磁通量：每片有自己的法向</h3><span>磁通量 · 曲面积分</span></div>
    <svg viewBox="0 0 690 340" role="img" aria-label="左侧曲面和取样网格均由同一参数曲面生成，一处局部小面片高亮，蓝色法向按局部切向量叉积计算。右侧放大该面片的切平面，显示局部磁场和法向。">
      <defs>
        <marker id="fc-b-arr" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="var(--red)"/></marker>
        <marker id="fc-n-arr" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="var(--curve)"/></marker>
      </defs>
      <text x="18" y="23" class="figure-title">曲面 S：选一小片，再近似成局部平面</text>
      <path d={curveOutline} fill="var(--green)" fill-opacity=".09" stroke="var(--curve)" stroke-width="2.3"/>
      {curveGridU.map(d=><path d={d} fill="none" stroke="var(--curve)" stroke-width="1.05" stroke-opacity=".27"/>)}
      {curveGridV.map(d=><path d={d} fill="none" stroke="var(--curve)" stroke-width="1.05" stroke-opacity=".27"/>)}
      {curveFieldTips.map(({p,tip})=><path d={pathPoints([p,tip])} fill="none" stroke="var(--red)" stroke-width="2.4" stroke-opacity=".66" marker-end="url(#fc-b-arr)"/>)}
      <path d={patchPath} fill="var(--green)" fill-opacity=".38" stroke="var(--green)" stroke-width="2.8"/>
      <path d={pathPoints([curveCenter,curveNtip])} fill="none" stroke="var(--curve)" stroke-width="3.4" marker-end="url(#fc-n-arr)"/>
      <circle cx={curveCenter.x} cy={curveCenter.y} r="4.5" fill="var(--fg)"/>
      <text x={curveNtip.x-21} y={curveNtip.y-7} class="figure-point">n̂ᵢ</text>
      <text x="41" y="238" class="figure-point">S</text>
      <text x={curveCenter.x+15} y={curveCenter.y+20} class="tick">ΔAᵢ</text>
      <path d={'M '+(curveCenter.x+17)+' '+(curveCenter.y+4)+' Q 411 80 462 113'} stroke="var(--curve)" stroke-width="1.8" fill="none" stroke-dasharray="5 4"/>
      <rect x="455" y="44" width="217" height="247" rx="8" fill="var(--soft)" fill-opacity=".23" stroke="var(--border)" stroke-width="1.6"/>
      <text x="473" y="69" class="figure-point">局部面片放大</text>
      <path d={pathPoints(zoomCorners,true)} fill="var(--green)" fill-opacity=".19" stroke="var(--green)" stroke-width="2.4"/>
      <path d={pathPoints([zoomCenter,zoomNtip])} fill="none" stroke="var(--curve)" stroke-width="3.5" marker-end="url(#fc-n-arr)"/>
      <path d={pathPoints([zoomCenter,zoomP(vAdd(cCenter,vScale(fluxB,55)))])} fill="none" stroke="var(--red)" stroke-width="3.3" marker-end="url(#fc-b-arr)"/>
      <circle cx={zoomCenter.x} cy={zoomCenter.y} r="3.7" fill="var(--fg)"/>
      <text x={zoomNtip.x-19} y={zoomNtip.y-7} class="figure-point">n̂ᵢ</text>
      <text x="615" y="111" class="figure-point">B</text>
      <text x="555" y="220" class="tick">局部切平面</text>
      <text x="470" y="254" class="legend">ΔΦᵢ ≈ B(rᵢ) · n̂ᵢ ΔAᵢ</text>
      <text x="470" y="276" class="tick">每片求出贡献，再累加</text>
      <text x="18" y="328" class="tick">曲面按参数方程生成，法向由同一处的两根局部切向量叉积求出。</text>
    </svg>
    <figcaption>曲面网格代表取样方向。右侧放大的是选中点附近的局部切平面，不代表整张曲面都平坦。每一片的法向和磁场投影可能不同，通量是所有面片带符号贡献的和。</figcaption>
  </>}
  {kind === 'divergence' && <>
    <div class="figure-top"><h3>流进来多少？流出去多少？</h3><span>图 5 · 小盒子的净通量</span></div>
    <svg viewBox="0 0 690 347" role="img" aria-label="三维透视小长方体，左侧蓝色箭头流入，右侧较长的蓝色箭头流出；在远离图形的右侧单独注明两面外法向方向和右通量减左通量">
<defs><marker id="d-new-flow" markerWidth="8" markerHeight="8" refX="6.7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="var(--curve)"/></marker></defs>
<text x="14" y="23" class="figure-title">先只比较 x 方向的左右两个面</text>
<path d="M136 97L284 97L339 57L190 57Z" fill="var(--soft)" stroke="var(--muted)" stroke-width="1.5"/>
<path d="M136 97L284 97L284 242L136 242Z" fill="var(--curve)" fill-opacity=".08" stroke="var(--curve)" stroke-width="1.8"/>
<path d="M284 97L339 57L339 202L284 242Z" fill="var(--green)" fill-opacity=".19" stroke="var(--green)" stroke-width="2.8"/>
<path d="M136 97L190 57M190 57V202L136 242M190 202L339 202" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="4 5" fill="none"/>
<path d="M46 151H134M46 197H134" stroke="var(--curve)" stroke-width="2.7" marker-end="url(#d-new-flow)"/>
<path d="M337 147H424M337 194H424" stroke="var(--curve)" stroke-width="3.8" marker-end="url(#d-new-flow)"/>
<text x="66" y="139" class="legend">流入</text><text x="354" y="134" class="legend">流出</text>
<text x="162" y="284" class="legend" text-anchor="middle">左面朝外：−x</text>
<text x="329" y="284" class="legend" text-anchor="middle">右面朝外：+x</text>
<path d="M456 52H456V291" stroke="var(--border)" stroke-width="1.2"/>
<text x="474" y="84" class="figure-point">右侧通量</text>
<text x="474" y="110" class="figure-point">减去左侧通量</text>
<text x="474" y="151" class="legend">两面面积相同</text>
<text x="474" y="180" class="legend">右侧场分量更大</text>
<text x="474" y="209" class="legend">→ 净向外流出为正</text>
<text x="474" y="268" class="tick">另外两对面也类似</text>
<text x="17" y="329" class="tick">画的是通量的方向与大小比较，不代表仅凭几根箭头就能证明散度公式。</text>
</svg>
