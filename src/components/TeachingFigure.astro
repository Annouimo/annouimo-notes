      {Array.from({length:12},(_,j)=>j*Math.PI/6).map(t=><path d={'M'+(222+20*Math.cos(t))+' '+(156+20*Math.sin(t))+' L'+(222+143*Math.cos(t))+' '+(156+143*Math.sin(t))} fill="none" stroke="var(--curve)" stroke-width="1.4" opacity=".65" marker-end="url(#gs-ar)"/>)}
