  </>}

  {kind === 'gauss-sphere' && <>
    <div class="figure-top"><h3>场强变弱，球面却在变大</h3><span>高斯定律 · 球面</span></div>
    <svg viewBox="0 0 640 320" role="img" aria-label="以正点电荷为中心的两个同心球面的截面图，半径为r和R，电场向外辐射。球面面积随半径平方增长，场强随半径平方减弱，通量相同。">
